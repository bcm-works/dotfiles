#!/usr/bin/env just --justfile
#
#
# Just command runner configuration
#   - Initial setup: bash ./setup-just-commands-user.sh
#   - Then you can run from any directory (lists all options): ujust
#   - More info at https://github.com/casey/just
#
#

# Set default config

set shell := ["bash", "-uc"]
set ignore-comments := true
set quiet := true

# Add alias commands

alias help := list
alias ls := list
alias menu := choose
alias upgrade := update
alias up := update
alias rm := clean
alias ref := refresh
alias ai := ai-install

# Default to the 'list' command, when 'just' is run without any parameters
[group('just')]
default: list

# Show a graphical selector listing the available options and their script content
[group('just')]
choose:
  @just --choose --justfile "{{ justfile() }}"

# Show a list of the available 'run' commands
[group('just')]
list:
  @echo '{{ style("warning") }}Listing "just" command options from {{ justfile() }}{{ NORMAL }}'
  just --justfile "{{ justfile() }}" --list --alias-style 'right' --list-heading '' --list-prefix ''

# Get the OS name
[group('tools')]
os:
  #!/usr/bin/env bash
  source "$HOME/Dotfiles/utils.sh";
  echo "$(os)";

# Get the OS name, in a clean format
[group('tools')]
os_clean:
  #!/usr/bin/env bash
  source "$HOME/Dotfiles/utils.sh";
  echo "$(os_clean)";

# Checks if the OS is Arch Linux based, returns "true" or "false" as strings.
[group('tools')]
os_arch_based:
  #!/usr/bin/env bash
  source "$HOME/Dotfiles/utils.sh";
  echo "$(os_arch_based)";

# Checks if the OS is Debian based, returns "true" or "false" as strings.
[group('tools')]
os_debian_based:
  #!/usr/bin/env bash
  source "$HOME/Dotfiles/utils.sh";
  echo "$(os_debian_based)";

# Get the name of the Linux DE
[group('tools')]
os_desktop:
  #!/usr/bin/env bash
  source "$HOME/Dotfiles/utils.sh";
  echo "$(os_desktop)";

# Get the name of the Linux DE, in a clean format
[group('tools')]
os_desktop_clean:
  #!/usr/bin/env bash
  source "$HOME/Dotfiles/utils.sh";
  echo "$(os_desktop_clean)";

# List local users
[group('system')]
users:
  awk -F: '$3 >= 1000 && $1 != "nobody" && $0="- " $1 " (" $3 ") at " $6' /etc/passwd

# Find which process is using a certain port number
[group('system')]
port port_number:
  sudo lsof -i ":{{ port_number }}" || echo "Port not in use"

# Get a disk partition label using the partition name (eg: nvme0n1p1)
[group('system')]
partition_label partition_name:
  find /dev/disk/ -lname '*{{ partition_name }}' | grep /dev/disk/by-partlabel/ | sed 's/\/dev\/disk\/by-partlabel\///'

# Backup Linux user data
[group('system')]
backup:
  bash "$HOME/Dotfiles/tools/backup-linux-user/backup-linux-user.sh"

# Install and update AI tools
[group('ai')]
ai-install:
  bash "$HOME/Dotfiles/ai/ai.sh"

# View the AI readme
[group('ai')]
ai-docs:
  #!/usr/bin/env bash
  if command -v glow > /dev/null 2>&1 ; then
    glow "$HOME/Dotfiles/ai/README.md"
  else
    cat "$HOME/Dotfiles/ai/README.md"
  fi

# Show your current public IP address
[group('system')]
ip:
  dig +short myip.opendns.com @resolver1.opendns.com

# Run 'update' then 'clean'
[group('system')]
refresh: update clean
  echo "! Both 'update' and 'clean' tasks are finished, a system reboot is recommended."

# Update system packages and apps
[group('system')]
update:
  #!/usr/bin/env bash
  source "$HOME/Dotfiles/utils.sh";
  OS=$(just --justfile "{{ justfile() }}" os_clean);
  OS_DEBIAN=$(just --justfile "{{ justfile() }}" os_debian_based);
  info "Starting update task";
  warn "Requesting sudo";
  sudo -v;
  if [[ "$OS" == 'fedora' ]]; then
    info 'Fedora - Updating packages';
    sudo dnf upgrade --refresh -y > /dev/null 2>&1;
    info 'Fedora - Updating firmware';
    sudo fwupdmgr get-updates > /dev/null 2>&1;
    sudo fwupdmgr update -y > /dev/null 2>&1;
  elif [[ "$OS" == 'fedora-atomic' ]]; then
    info 'Fedora Atomic - Updating packages';
    rpm-ostree upgrade --quiet;
  fi
  if command -v pacman > /dev/null 2>&1; then
    info 'Pacman - Updating packages';
    sudo pacman -Sy > /dev/null 2>&1;
    sudo pacman -Su > /dev/null 2>&1;
  fi
  if command -v yay > /dev/null 2>&1; then
    info 'Yay - Updating packages';
    yay -Sua > /dev/null 2>&1;
  fi
  if command -v apt > /dev/null 2>&1 ; then
    info 'APT - Updating packages';
    sudo apt update -y -qq > /dev/null 2>&1;
    sudo apt upgrade -y -qq > /dev/null 2>&1;
  fi
  if command -v snap > /dev/null 2>&1 ; then
    info 'Snap - Updating packages';
    sudo snap refresh > /dev/null 2>&1;
  fi
  if command -v flatpak > /dev/null 2>&1 ; then
    info 'Flatpak - Updating packages';
    flatpak update -y > /dev/null 2>&1;
  fi
  if command -v brew > /dev/null 2>&1 ; then
    info 'Homebrew - Updating packages';
    brew update > /dev/null 2>&1;
    brew upgrade > /dev/null 2>&1;
  fi

# Clean packages and temp files
[group('system')]
clean:
  #!/usr/bin/env bash
  source "$HOME/Dotfiles/utils.sh";
  OS=$(just --justfile "{{ justfile() }}" os);
  OS_ARCH=$(just --justfile "{{ justfile() }}" os_arch_based);
  OS_DEBIAN=$(just --justfile "{{ justfile() }}" os_debian_based);
  info "Starting clean task";
  warn 'Requesting sudo';
  sudo -v;
  if [ OS_ARCH ]; then
    info "$OS - Cleanup packages";
    paccache -rvk2 > /dev/null 2>&1;
    paccache -ruk0 > /dev/null 2>&1;
    sudo pacman -Rns $(pacman -Qtdq) --noconfirm > /dev/null 2>&1;
    info "$OS - Empty cache";
    rm -rf "$HOME/.cache/"* > /dev/null 2>&1;
    info "$OS - Remove obsolete packages and caches";
    sudo paccache -ruk0 > /dev/null 2>&1;
    sudo pacman -Rns $(pacman -Qdtq) --noconfirm > /dev/null 2>&1;
    info "$OS - Remove old system journal logs";
    journalctl --vacuum-time=4weeks > /dev/null 2>&1;
  elif [[ "$OS" == 'Fedora' ]]; then
    info 'Fedora - Cleanup packages';
    sudo dnf autoremove -y > /dev/null 2>&1;
    sudo dnf clean all > /dev/null 2>&1;
  elif [ $OS_DEBIAN ]; then
    info "$OS - Cleanup APT packages";
    sudo apt autoremove -y > /dev/null 2>&1;
    sudo apt clean -y > /dev/null 2>&1;
    sudo apt autoclean -y > /dev/null 2>&1;
  fi
  if command -v flatpak > /dev/null 2>&1 ; then
    info 'Flatpak - Cleanup cache';
    rm -rf "$HOME/.cache/flatpak"
    mkdir -p "$HOME/.cache/flatpak"
    info 'Flatpak - Cleanup packages';
    flatpak uninstall -y --unused --delete-data > /dev/null 2>&1;
  fi
  if command -v brew > /dev/null 2>&1 ; then
    info 'Homebrew - Cleanup packages';
    brew cleanup > /dev/null 2>&1;
  fi

# Info about Just itself
[group('just')]
info:
  @echo "Just Version: $( just --version )"
  @echo "Process ID: {{ just_pid() }}"
  @echo "Binary: {{ just_executable() }}"
  @echo "Current Justfile: {{ justfile() }}"
  @echo "Current Dir: {{ invocation_directory() }}"
