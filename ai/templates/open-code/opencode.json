{
	"$schema": "https://opencode.ai/config.json",
	"model": "opencode/muse-spark-1.3-contributor-free",
	"provider": {
		"ollama": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "ollama-local",
			"options": {
				"baseURL": "http://localhost:11434/v1"
			},
			"models": {
				"gemma4:latest": {
					"name": "gemma4"
				}
			}
		}
	},
	"autoupdate": true,
	"default_agent": "plan",
	"share": "disabled",
	"compaction": {
		"auto": true,
		"prune": false,
		"reserved": 10000
	},
	"permission": {
		"edit": "allow",
		"question": "allow",
		"webfetch": "allow",
		"grep": "allow",
		"glob": "allow",
		"read": {
			"*": "allow",
			".env": "deny",
			".env.*": "deny"
		},
		"bash": {
			"*": "ask",
			"cat": "allow",
			"cat *": "allow",
			"ls": "allow",
			"ls *": "allow",
			"tail": "allow",
			"tail *": "allow",
			"deno task *": "allow",
			"eslint": "allow",
			"eslint *": "allow",
			"npx eslint": "allow",
			"npx eslint *": "allow",
			"git show": "allow",
			"git show *": "allow",
			"git status": "allow",
			"git status *": "allow",
			"git log": "allow",
			"git log *": "allow",
			"git commit": "deny",
			"git commit *": "deny",
			"git push": "deny",
			"git push *": "deny"
		}
	}
}