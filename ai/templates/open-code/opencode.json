{
	"$schema": "https://opencode.ai/config.json",
	"model": "opencode/muse-spark-1.3-contributor-free",
	"provider": {
		"ollama": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "ollama-local",
			"options": {
				"baseURL": "http://localhost:11434/v1"
			},
			"models": {
				"gemma4:latest": {
					"name": "gemma4"
				}
			}
		}
	},
	"autoupdate": true,
	"default_agent": "plan",
	"share": "disabled",
	"compaction": {
		"auto": true,
		"prune": false,
		"reserved": 10000
	},
	"permission": {
		"edit": "allow",
		"question": "allow",
		"webfetch": "allow",
		"grep": "allow",
		"glob": "allow",
		"read": {
			"*": "allow",
			".env": "deny",
			"*.env": "deny",
			".env.*": "deny",
			"docs/AI-USE.md": "deny"
		},
		"bash": {
			"*": "ask",
			"basename": "allow",
			"basename *": "allow",
			"cat": "allow",
			"cat *": "allow",
			"cut": "allow",
			"cut *": "allow",
			"date": "allow",
			"date *": "allow",
			"df": "allow",
			"df *": "allow",
			"dirname": "allow",
			"dirname *": "allow",
			"docker compose ps": "allow",
			"docker compose ps *": "allow",
			"docker images": "allow",
			"docker images *": "allow",
			"docker ps": "allow",
			"docker ps *": "allow",
			"du": "allow",
			"du *": "allow",
			"echo": "allow",
			"echo *": "allow",
			"file": "allow",
			"file *": "allow",
			"find": "allow",
			"find *": "allow",
			"free": "allow",
			"free *": "allow",
			"git blame": "allow",
			"git blame *": "allow",
			"git branch": "allow",
			"git branch *": "allow",
			"git diff": "allow",
			"git diff *": "allow",
			"git ls-files": "allow",
			"git ls-files *": "allow",
			"git log": "allow",
			"git log *": "allow",
			"git remote": "allow",
			"git remote *": "allow",
			"git rev-parse": "allow",
			"git rev-parse *": "allow",
			"git show": "allow",
			"git show *": "allow",
			"git status": "allow",
			"git status *": "allow",
			"git tag": "allow",
			"git tag *": "allow",
			"grep": "allow",
			"grep *": "allow",
			"head": "allow",
			"head *": "allow",
			"hostname": "allow",
			"hostname *": "allow",
			"id": "allow",
			"id *": "allow",
			"less": "allow",
			"less *": "allow",
			"ls": "allow",
			"ls *": "allow",
			"lsblk": "allow",
			"lsblk *": "allow",
			"mount": "allow",
			"mount *": "allow",
			"ps": "allow",
			"ps *": "allow",
			"pwd": "allow",
			"pwd *": "allow",
			"readlink": "allow",
			"readlink *": "allow",
			"realpath": "allow",
			"realpath *": "allow",
			"rg": "allow",
			"rg *": "allow",
			"sort": "allow",
			"sort *": "allow",
			"stat": "allow",
			"stat *": "allow",
			"tail": "allow",
			"tail *": "allow",
			"tree": "allow",
			"tree *": "allow",
			"tr": "allow",
			"tr *": "allow",
			"uname": "allow",
			"uname *": "allow",
			"uniq": "allow",
			"uniq *": "allow",
			"uptime": "allow",
			"uptime *": "allow",
			"wc": "allow",
			"wc *": "allow",
			"which": "allow",
			"which *": "allow",
			"whoami": "allow",
			"whoami *": "allow",
			"git commit": "deny",
			"git commit *": "deny",
			"git push": "deny",
			"git push *": "deny"
		}
	}
}